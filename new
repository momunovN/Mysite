<script>
// script.js — полностью рабочая капча с swap и возвратом
let attempts = 0;
const MAX_ATTEMPTS = 3;
const correctOrder = [1, 2, 3, 4];

function initCaptcha() {
    const puzzle = document.getElementById('captcha-puzzle');
    const pool = document.getElementById('captcha-pool');
    
    puzzle.innerHTML = '';
    pool.innerHTML = '';

    // Перемешиваем
    let pieces = [1, 2, 3, 4].sort(() => Math.random() - 0.5);

    pieces.forEach(num => {
        const piece = createPiece(num);
        pool.appendChild(piece);
    });

    // 4 квадратных слота
    for (let i = 0; i < 4; i++) {
        const slot = document.createElement('div');
        slot.className = 'slot';
        slot.dataset.position = i;
        
        slot.addEventListener('dragover', e => e.preventDefault());
        slot.addEventListener('drop', handleDropOnSlot);
        
        puzzle.appendChild(slot);
    }
}

function createPiece(num) {
    const piece = document.createElement('div');
    piece.className = 'piece';
    piece.draggable = true;
    piece.dataset.id = num;
    piece.style.backgroundImage = `url(images/${num}.png)`;
    
    piece.addEventListener('dragstart', e => {
        e.dataTransfer.setData('text/plain', piece.dataset.id);
        piece.classList.add('dragging');
    });

    piece.addEventListener('dragend', () => piece.classList.remove('dragging'));
    return piece;
}

// Основная функция drop (работает и в пул, и в слоты)
function handleDropOnSlot(e) {
    e.preventDefault();
    const id = e.dataTransfer.getData('text/plain');
    const draggedPiece = document.querySelector(`.piece[data-id="${id}"]`);
    if (!draggedPiece) return;

    const targetSlot = e.currentTarget;

    // Если слот занят — меняемся местами
    if (targetSlot.dataset.id) {
        const oldId = targetSlot.dataset.id;
        const oldPieceInPool = document.querySelector(`.piece[data-id="${oldId}"]`);
        
        // Возвращаем старую картинку в пул
        if (oldPieceInPool) {
            document.getElementById('captcha-pool').appendChild(oldPieceInPool);
        } else {
            // Если старой нет — создаём новую в пул
            const newPiece = createPiece(oldId);
            document.getElementById('captcha-pool').appendChild(newPiece);
        }
    }

    // Ставим новую картинку в слот
    targetSlot.style.backgroundImage = draggedPiece.style.backgroundImage;
    targetSlot.style.backgroundSize = 'cover';
    targetSlot.dataset.id = id;

    draggedPiece.remove(); // удаляем из пула
}

// Drag & Drop обратно из слота в пул
function makeSlotsDraggable() {
    const slots = document.querySelectorAll('.slot');
    slots.forEach(slot => {
        slot.addEventListener('dragstart', e => {
            if (slot.dataset.id) {
                e.dataTransfer.setData('text/plain', slot.dataset.id);
                slot.classList.add('dragging');
            }
        });

        slot.addEventListener('dragend', () => slot.classList.remove('dragging'));
    });
}

// Проверка
function checkCaptcha() {
    const slots = document.querySelectorAll('#captcha-puzzle .slot');
    const userOrder = Array.from(slots).map(slot => parseInt(slot.dataset.id || 0));

    const isCorrect = userOrder.join('') === correctOrder.join('');

    const msg = document.getElementById('message');
    if (isCorrect) {
        msg.innerHTML = '✅ <strong>Капча пройдена успешно!</strong>';
        msg.style.color = 'green';
    } else {
        attempts++;
        msg.innerHTML = `❌ Неверный порядок! Попытка ${attempts}/${MAX_ATTEMPTS}`;
        msg.style.color = 'red';

        if (attempts >= MAX_ATTEMPTS) {
            document.querySelector('button').disabled = true;
            msg.innerHTML += '<br><strong>Аккаунт заблокирован</strong>';
        } else {
            setTimeout(() => { initCaptcha(); makeSlotsDraggable(); }, 700);
        }
    }
}

window.onload = () => {
    initCaptcha();
    makeSlotsDraggable();
};
</script>

.slot, .piece {
    width: 120px;
    height: 120px;
    border: 3px solid #333;
    border-radius: 12px;
    background-size: cover;
    background-position: center;
    cursor: grab;
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
}

.slot {
    background-color: #f8f8f8;
    border-style: dashed;
}

.slot.dragging, .piece.dragging {
    opacity: 0.5;
    transform: scale(0.9);
}

.puzzle, .pool {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    padding: 20px;
    border: 2px dashed #666;
    border-radius: 15px;
    background: #fafafa;
    min-height: 160px;
}



<form id="loginForm">
    <input type="text" id="login" placeholder="Логин" required 
           minlength="3" maxlength="20" pattern="[a-zA-Z0-9_]+"><br><br>
    
    <input type="password" id="password" placeholder="Пароль" required 
           minlength="6"><br><br>
    
    <input type="email" id="email" placeholder="Email (необязательно)"><br><br>
    
    <!-- Капча остаётся -->
    <div class="captcha-container"> ... </div>
    
    <button type="button" onclick="validateAndLogin()">Войти</button>
</form>

function validateAndLogin() {
    const login = document.getElementById('login').value.trim();
    const password = document.getElementById('password').value;

    if (login.length < 3) {
        alert('Логин должен быть не менее 3 символов');
        return;
    }
    if (password.length < 6) {
        alert('Пароль должен быть не менее 6 символов');
        return;
    }

    // Если валидация прошла — проверяем капчу
    checkCaptcha();
}
